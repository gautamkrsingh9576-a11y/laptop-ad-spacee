            <svg
              viewBox="0 0 24 24"
              className="w-5 h-5 text-zinc-400 shrink-0"
              fill="none"
              stroke="currentColor"
              strokeWidth="1.8"
            >
              <circle cx="11" cy="11" r="6" />
              <path d="M16 16L21 21" />
            </svg>

            <input
              type="search"
              value={query}
              onChange={(e) =>
                setQuery(e.target.value)
              }
              maxLength={60}
              placeholder="Search news, topics..."
              className="w-full bg-transparent outline-none text-white placeholder:text-zinc-500"
            />

            {query && (
              <button
                type="button"
                onClick={() => setQuery("")}
                className="text-zinc-500 hover:text-white"
              >
                ×
              </button>
            )}

          </div>
        </form>

        {/* Recent Searches */}
        <section className="relative z-10 mt-9">

          <div className="flex items-center justify-between">
            <h2 className="text-lg font-semibold">
              Recent Searches
            </h2>

            {recentSearches.length > 0 && (
              <button
                onClick={() => setRecentSearches([])}
                className="text-xs text-[#ff3045]"
              >
                Clear All
              </button>
            )}
          </div>

          <div className="mt-4 space-y-2">

            {recentSearches.length === 0 && (
              <p className="text-sm text-zinc-600 py-4">
                No recent searches yet.
              </p>
            )}

            {recentSearches.map((item) => (
              <div
                key={item}
                className="h-14 px-4 rounded-[16px] bg-[#11141a] border border-white/5 flex items-center justify-between"
              >

                <div className="flex items-center gap-3">
                  <span className="text-zinc-500">
                    ◷
                  </span>

                  <span className="text-sm text-zinc-300">
                    {item}
                  </span>
                </div>

                <button
                  onClick={() =>
                    removeRecent(item)
                  }
                  className="text-zinc-600 hover:text-white"
                >
                  ×
                </button>

              </div>
            ))}

          </div>
        </section>

        {/* Trending */}
        <section className="relative z-10 mt-9">

          <div className="flex items-center gap-2">
            <span className="text-xl">
              🔥
            </span>

            <h2 className="text-lg font-semibold">
              Trending Now
            </h2>
          </div>

          <div className="mt-5 space-y-4">

            {trending.map((item, index) => (
              <button
                key={item}
                onClick={() => setQuery(item)}
                className="w-full flex items-center gap-4 text-left"
              >

                <span
                  className={`w-7 text-sm font-bold ${
                    index < 3
                      ? "text-[#ff3045]"
                      : "text-zinc-600"
                  }`}
                >
                  {index + 1}
                </span>

                <span className="text-sm text-zinc-300 hover:text-white transition">
                  {item}
                </span>

              </button>
            ))}

          </div>

        </section>

        {/* Bottom Navigation */}
<BottomNav />
      </div>

    </main>
  );
